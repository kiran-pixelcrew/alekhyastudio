# Gmail SMTP credentials (use an App Password, not your regular Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password

# Optional: override the sender shown in the inbox (defaults to SMTP_USER)
# SMTP_FROM="Alekhya Studio <your-gmail-address@gmail.com>"

# Where contact form submissions are delivered
CONTACT_TO_EMAIL=you@example.com

# MongoDB Atlas connection string (include a database name)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/alekhyastudio?retryWrites=true&w=majority

# Random secret for signing admin session cookies (32+ chars)
AUTH_SECRET=replace-with-a-long-random-string

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional: unsigned preset for fast browser→Cloudinary video uploads (auto-created if missing)
# CLOUDINARY_VIDEO_UPLOAD_PRESET=alekhya_videography_unsigned

# Used only by `npm run seed:admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Admin
