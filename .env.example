# Resend (https://resend.com) — preferred for Vercel contact form email
# Create an API key in the Resend dashboard, then set:
RESEND_API_KEY=re_xxxxxxxx
# Sender address. Until you verify your domain, use Resend's test sender:
# RESEND_FROM="Alekhya Studio <onboarding@resend.dev>"
# With a verified domain (recommended for production):
# RESEND_FROM="Alekhya Studio <hello@yourdomain.com>"
RESEND_FROM="Alekhya Studio <onboarding@resend.dev>"

# Where contact form submissions are delivered
# Note: with onboarding@resend.dev you can only send TO your Resend account email
CONTACT_TO_EMAIL=you@example.com

# MongoDB Atlas connection string (include a database name)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/alekhyastudio?retryWrites=true&w=majority

# Random secret for signing admin session cookies (32+ chars)
AUTH_SECRET=replace-with-a-long-random-string

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional: unsigned preset for fast browser→Cloudinary video uploads (auto-created if missing)
# CLOUDINARY_VIDEO_UPLOAD_PRESET=alekhya_videography_unsigned

# Used only by `npm run seed:admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Admin
